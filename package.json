{
  "name": "hello-travel-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write src vite.config.ts index.html *.json",
    "format:check": "prettier --check src vite.config.ts index.html *.json"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-virtual": "3.14.13",
    "antd": "6.6.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
